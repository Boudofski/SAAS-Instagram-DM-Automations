// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId             String               @unique
  email               String               @unique
  firstname           String?
  lastname            String?
  status              String               @default("ACTIVE")
  suspendedAt         DateTime?
  suspendedReason     String?
  createdAt           DateTime             @default(now())
  subscription        Subscription?
  integrations        Integrations[]
  automations         Automation[]
  conversations       Conversation[]
  metaOAuthSelections MetaOAuthSelection[]
  referralPartner     ReferralPartner?     @relation("ReferralPartnerOwner")
  referralAttribution ReferralAttribution? @relation("ReferredUser")
}

model Subscription {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  User                   User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String?           @unique @db.Uuid
  createdAt              DateTime          @default(now())
  plan                   SUBSCRIPTION_PLAN @default(FREE)
  updatedAt              DateTime          @default(now())
  customerId             String?           @unique
  usageResetAt           DateTime?
  welcomeTrialStartedAt  DateTime?
  welcomeTrialEndsAt     DateTime?
  welcomeTrialReplyLimit Int?

  // Internal Overrides
  monthlyReplyLimitOverride     Int?
  activeCampaignLimitOverride   Int?
  connectedAccountLimitOverride Int?
  aiReplyLimitOverride          Int?
  overrideReason                String?
  overrideExpiresAt             DateTime?
}

model ReferralPartner {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @unique @db.Uuid
  user        User      @relation("ReferralPartnerOwner", fields: [userId], references: [id], onDelete: Cascade)
  code        String    @unique @db.VarChar(24)
  founderRank Int?      @unique
  qualifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attributions ReferralAttribution[]
  rewards      ReferralReward[]

  @@index([createdAt])
}

model ReferralAttribution {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId          String                      @db.Uuid
  partner            ReferralPartner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referredUserId     String                      @unique @db.Uuid
  referredUser       User                        @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  status             REFERRAL_ATTRIBUTION_STATUS @default(SIGNED_UP)
  connectedAt        DateTime?
  qualifiedAt        DateTime?
  firstPaidInvoiceId String?                     @unique
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  reward ReferralReward?

  @@index([partnerId, status])
  @@index([createdAt])
}

model ReferralReward {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId                  String                 @db.Uuid
  partner                    ReferralPartner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  attributionId              String                 @unique @db.Uuid
  attribution                ReferralAttribution    @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  qualifyingInvoiceId        String                 @unique
  amountCents                Int                    @default(900)
  currency                   String                 @default("usd") @db.VarChar(3)
  status                     REFERRAL_REWARD_STATUS @default(PENDING)
  stripeBalanceTransactionId String?                @unique
  failureReason              String?
  createdAt                  DateTime               @default(now())
  appliedAt                  DateTime?
  reversedAt                 DateTime?

  @@index([partnerId, status])
  @@index([createdAt])
}

model Integrations {
  id                                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                               INTEGRATIONS               @default(INSTAGRAM)
  createdAt                          DateTime                   @default(now())
  User                               User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                             String?                    @db.Uuid
  token                              String                     @unique
  expiresAt                          DateTime?
  instagramId                        String?                    @unique
  metaAppScopedUserId                String?
  webhookAccountId                   String?
  pageId                             String?
  pageName                           String?
  businessId                         String?
  instagramUsername                  String?
  profilePictureUrl                  String?
  igAccountSource                    String?
  oauthResolutionDiagnostics         Json?
  webhookSubscriptionLastAttemptedAt DateTime?
  webhookSubscriptionStatusCode      Int?
  webhookSubscriptionSubscribed      Boolean?
  webhookSubscriptionMode            String?
  webhookSubscriptionError           String?
  oauthLastError                     String?
  oauthLastErrorAt                   DateTime?
  oauthLastErrorSource               String?
  status                             String                     @default("CONNECTED")
  disconnectedAt                     DateTime?
  disconnectedReason                 String?
  reconnectRequired                  Boolean                    @default(false)
  lastAdminNote                      String?
  lastAdminActionAt                  DateTime?
  snapshots                          InstagramAccountSnapshot[]

  @@index([metaAppScopedUserId])
}

model InstagramAccountSnapshot {
  id            String       @id @default(cuid())
  integrationId String       @db.Uuid
  integration   Integrations @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  instagramId       String?
  username          String?
  profilePictureUrl String?
  followersCount    Int?
  mediaCount        Int?
  accountType       String?

  source    String   @default("meta_graph")
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([integrationId, fetchedAt])
  @@index([instagramId])
}

model MetaOAuthSelection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  accounts  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Automation {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String            @default("Untitled")
  createdAt            DateTime          @default(now())
  active               Boolean           @default(false)
  matchingMode         MATCHING_MODE     @default(CONTAINS)
  triggerMode          String            @default("SPECIFIC_KEYWORD")
  sendPrivateDm        Boolean           @default(true)
  source               String            @default("COMMENT")
  storyTriggerType     String?
  followGateRequired   Boolean           @default(false)
  typingIndicator      Boolean           @default(false)
  deliveryDelaySeconds Int               @default(0)
  needsReview          Boolean           @default(false)
  reviewReason         String?
  archivedAt           DateTime?
  archivedByAdminEmail String?
  archiveReason        String?
  trigger              Trigger[]
  listener             Listener?
  posts                Post[]
  dms                  Dms[]
  User                 User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String?           @db.Uuid
  keywords             Keyword[]
  leads                Lead[]
  events               AutomationEvent[]
  messageLogs          MessageLog[]
  webhookEvents        WebhookEvent[]
  conversations        Conversation[]
}

model Dms {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Automation   Automation? @relation(fields: [automationId], references: [id])
  automationId String?     @db.Uuid
  createdAt    DateTime    @default(now())
  senderId     String?
  reciever     String?
  message      String?
}

model Post {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postid       String
  caption      String?
  media        String
  mediaType    MEDIATYPE   @default(IMAGE)
  Automation   Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String?     @db.Uuid
}

model Listener {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId   String     @unique @db.Uuid
  listener       LISTENERS  @default(MESSAGE)
  prompt         String
  commentReply   String?
  commentReply2  String?
  commentReply3  String?
  ctaLink        String?
  ctaButtonTitle String?
  responseFormat String     @default("TEXT")
  quickReplies   Json?
  mediaUrl       String?
  mediaType      String?
  openingDmText            String?
  openingDmButtonText      String?
  followRequestDmText      String?
  followRequestButtonText  String?
  dmCount        Int        @default(0)
  commentCount   Int        @default(0)
}

model Conversation {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String         @db.Uuid
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationId      String?        @db.Uuid
  automation        Automation?    @relation(fields: [automationId], references: [id], onDelete: SetNull)
  recipientIgId     String
  recipientUsername String?
  profilePictureUrl String?
  lastMessageAt     DateTime       @default(now())
  lastInboundAt     DateTime?
  unreadCount       Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  messages          InboxMessage[]

  @@unique([userId, recipientIgId])
  @@index([userId, lastMessageAt])
}

model InboxMessage {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  metaMessageId  String?      @unique
  senderIgId     String
  direction      String
  content        String
  messageType    String       @default("TEXT")
  status         String       @default("RECEIVED")
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Trigger {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         String
  Automation   Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String?     @db.Uuid
}

model Keyword {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  word         String
  Automation   Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String?     @db.Uuid

  @@unique([automationId, word])
}

model Lead {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automationId String     @db.Uuid
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  igUserId     String
  igUsername   String?
  commentText  String?
  mediaId      String?
  createdAt    DateTime   @default(now())

  @@unique([automationId, igUserId])
}

model AutomationEvent {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automationId String     @db.Uuid
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  eventType    EVENT_TYPE
  igUserId     String?
  mediaId      String?
  commentId    String?
  keyword      String?
  meta         Json?
  createdAt    DateTime   @default(now())
}

model WebhookEvent {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automationId String?     @db.Uuid
  automation   Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  provider     String      @default("meta")
  eventSource  String      @default("META_REAL")
  eventType    String
  field        String?
  igAccountId  String?
  igUserId     String?
  mediaId      String?
  commentId    String?
  status       String      @default("RECEIVED")
  errorMessage String?
  payload      Json?
  createdAt    DateTime    @default(now())
  processedAt  DateTime?

  @@index([automationId, createdAt])
  @@index([igAccountId, createdAt])
  @@index([commentId])
  @@index([eventSource, createdAt])
}

model MessageLog {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automationId  String       @db.Uuid
  automation    Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  recipientIgId String
  mediaId       String?
  commentId     String?
  messageType   MESSAGE_TYPE
  status        SEND_STATUS
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime     @default(now())
}

model AdminAuditLog {
  id String @id @default(cuid())

  adminUserId String?
  adminEmail  String?

  action      String
  targetType  String
  targetId    String?
  targetLabel String?

  reason       String?
  confirmation String?

  before   Json?
  after    Json?
  metadata Json?

  status String  @default("SUCCESS")
  error  String?

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([adminEmail, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SUBSCRIPTION_PLAN {
  PRO
  BUSINESS
  FREE
}

enum REFERRAL_ATTRIBUTION_STATUS {
  SIGNED_UP
  CONNECTED
  QUALIFIED
  WAITLISTED
}

enum REFERRAL_REWARD_STATUS {
  PENDING
  APPLIED
  REVERSED
}

enum INTEGRATIONS {
  INSTAGRAM
}

enum MEDIATYPE {
  IMAGE
  VIDEO
  CAROUSEL_ALBUM
}

enum LISTENERS {
  SMARTAI
  MESSAGE
}

enum MATCHING_MODE {
  EXACT
  CONTAINS
  SMART_AI
}

enum EVENT_TYPE {
  WEBHOOK_RECEIVED
  COMMENT_RECEIVED
  KEYWORD_MATCHED
  DM_SENT
  DM_SKIPPED
  PUBLIC_REPLY_SENT
  DM_FAILED
  PUBLIC_REPLY_FAILED
  DUPLICATE_SKIPPED
  SELF_COMMENT_SKIPPED
  COMMENT_SKIPPED
  LOOP_GUARD_TRIGGERED
  LOOP_GUARD_PAUSED_CAMPAIGN
  NO_MATCH
}

enum MESSAGE_TYPE {
  DM
  COMMENT_REPLY
}

enum SEND_STATUS {
  SENT
  FAILED
  SKIPPED
}
