# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────
# Clerk Authentication
# https://dashboard.clerk.com → your app → API Keys
# ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
ADMIN_EMAILS=
ADMIN_CLERK_USER_IDS=

# ─────────────────────────────────────────────
# App URL
# ─────────────────────────────────────────────
NEXT_PUBLIC_HOST_URL=https://your-domain.com

# ─────────────────────────────────────────────
# Stripe Billing
# https://dashboard.stripe.com → Developers → API keys
#
# Preferred AP3K catalog:
#   Pro monthly      $9   lookup key: ap3k_pro_month
#   Pro annual       $79  lookup key: ap3k_pro_year
#   Business monthly $29  lookup key: ap3k_business_month
#   Business annual  $279 lookup key: ap3k_business_year
#
# The explicit price-ID variables below are optional when those lookup keys
# exist in Stripe. They are useful when pinning a deployment to exact prices.
# Legacy Creator/Agency variables remain supported for old deployments.
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_ANNUAL=
# Legacy compatibility only
STRIPE_PRICE_ID_CREATOR=
STRIPE_PRICE_ID_AGENCY=
STRIPE_SUBSCRIPTION_PRICE_ID=

# ─────────────────────────────────────────────
# Meta / Instagram API
# https://developers.facebook.com → your app
#
# AP3k supports two connection modes while the migration is in progress:
# 1) Legacy Facebook Login for Business — Page token + linked Instagram account.
# 2) New Business Login for Instagram — direct Instagram professional account token.
#
# Keep INSTAGRAM_LOGIN_ENABLED=false until the Instagram API setup below is
# configured in Meta Developers and the first direct-login test succeeds.
# ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=your-meta-verify-token
META_REDIRECT_URI=https://your-domain.com/callback/instagram

# New direct Instagram Login path
INSTAGRAM_LOGIN_ENABLED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-domain.com/callback/instagram
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_OAUTH_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_LOGIN_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages

# Legacy variable aliases retained for old deploys/scripts; new code uses the
# INSTAGRAM_* names above.
INSTAGRAM_BASE_URL=https://graph.instagram.com
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token

# ─────────────────────────────────────────────
# OpenAI (reserved for Smart AI listener mode)
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────
# SEO / Search Console
# Add the HTML-tag verification token from Google Search Console.
# ─────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=

# ─────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_REVIEW_MODE=false
# Private messaging preflight only for the legacy Facebook Login path. When true,
# Facebook Login requests instagram_manage_messages. Reconnect the Instagram
# account after enabling; stored Page tokens do not gain new scopes automatically.
NEXT_PUBLIC_MESSAGING_REVIEW_MODE=false
# Preview/local only: allow a Clerk session whose ID differs across
# environments to use an existing normal workspace with the exact same email.
# This never changes the stored clerkId and is ignored when VERCEL_ENV=production.
AP3K_DEV_ALLOW_EMAIL_PROFILE_CLAIM=false
# REDIS_URL=redis://localhost:6379   # reserved for future async queue
